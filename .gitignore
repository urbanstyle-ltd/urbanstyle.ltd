# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Firebase service account key (NEVER commit)
service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# processed images (uploaded to Firebase Storage, not in git)
/processed

# source images (large PNGs, stored in Firebase)
/public/images/products
/public/images/personas
/public/images/hero
/public/images/brand
